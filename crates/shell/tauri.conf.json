{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gui",
  "version": "0.1.0",
  "identifier": "com.sudarsh.omp-gui",
  "build": {
    "beforeDevCommand": "vp run gui#dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vp run gui#build",
    "frontendDist": "../../gui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "gui",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["binaries/omp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
